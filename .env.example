# Disables the ESLint webpack plugin during dev/build. This avoids version-mismatch
# crashes between react-scripts' bundled ESLint config and whatever ESLint plugin
# versions npm happens to resolve on your machine (e.g. the "jest/globals" error).
# Your code isn't affected — this only turns off in-browser lint warnings.
DISABLE_ESLINT_PLUGIN=true
